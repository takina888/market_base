{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARKET BASE Photo Registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_version",
    "updated_at",
    "photos"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "registry_version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "update_rule": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "photo_id",
          "display_locations",
          "display_order",
          "status"
        ],
        "properties": {
          "photo_id": {
            "type": "string"
          },
          "company_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "store_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "country_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "article_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "database_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "local_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumbnail_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_page_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "photographer": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "license_url": {
            "type": "string"
          },
          "caption_ja": {
            "type": "string"
          },
          "photo_type": {
            "type": "string"
          },
          "display_locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_primary": {
            "type": "boolean"
          },
          "display_order": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "published",
              "hidden",
              "rejected"
            ]
          }
        }
      }
    }
  }
}
